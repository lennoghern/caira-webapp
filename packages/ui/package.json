{
  "name": "@caira/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Web component library inspired by Apple's Human Interface Guidelines. Not an Apple product.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./foundations": "./src/foundations/index.ts",
    "./content": "./src/content/index.ts",
    "./layout": "./src/layout/index.ts",
    "./menus": "./src/menus/index.ts",
    "./navigation": "./src/navigation/index.ts",
    "./presentation": "./src/presentation/index.ts",
    "./selection": "./src/selection/index.ts",
    "./status": "./src/status/index.ts",
    "./system": "./src/system/index.ts",
    "./next": "./src/next/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "stories": "vite -c tests/browser/harness/vite.config.mts",
    "build-stories": "vite build -c tests/browser/harness/vite.config.mts",
    "test:browser": "vite build -c tests/browser/harness/vite.config.mts && playwright test"
  },
  "peerDependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^1.53.0",
    "react-aria-components": "1.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-react-aria-components": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "^10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
